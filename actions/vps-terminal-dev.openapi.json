{
  "openapi": "3.1.0",
  "info": {
    "title": "VPS Terminal - Dev",
    "version": "0.7.0-dev.1",
    "description": "DEV ONLY. Isolated VPS Terminal Action for the dedicated Coolify development environment. Never use this Action as production authority or for production mutations. Exposes core terminal diagnostics plus Wave-2 guidance, enforced mediation evidence, durable lesson review/retrieval and public-token approval preparation/status. Validator execution and approval-decision endpoints intentionally remain outside this single-bearer GPT Action because the server requires separate credentials."
  },
  "servers": [
    {"url": "https://vps-terminal-dev.srv1904412.hstgr.cloud"}
  ],
  "security": [{"Bearer": []}],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Check DEV VPS Terminal liveness",
        "security": [],
        "responses": {"200": {"description": "OK"}}
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready",
        "summary": "Check DEV VPS Terminal and Docker readiness",
        "security": [],
        "responses": {"200": {"description": "Ready"}, "503": {"description": "Not ready"}}
      }
    },
    "/api/v1/version": {
      "get": {
        "operationId": "version",
        "summary": "Read DEV service version, guidance, mediation and durable-plane status",
        "responses": {"200": {"description": "Version and runtime status"}, "503": {"description": "Startup self-test not ready"}}
      }
    },
    "/v1/operator-guidance": {
      "post": {
        "operationId": "getOperatorGuidance",
        "summary": "Get DEV operator guidance, advice and relevant VERIFIED lessons",
        "description": "Caller intent, target_id and signals are advisory/untrusted context. Actual operations are classified and mediated server-side.",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["intent"],
            "properties": {
              "intent": {"type": "string", "minLength": 1, "maxLength": 120},
              "operation": {"type": "string", "maxLength": 120},
              "target_class": {"type": "string", "maxLength": 120},
              "target_id": {"type": "string", "maxLength": 160},
              "problem_class": {"type": "string", "maxLength": 80},
              "signals": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 160}}
            }
          }}}
        },
        "responses": {"200": {"description": "Guidance with advice and lesson matches"}, "400": {"description": "Bad request"}, "401": {"description": "Unauthorized"}}
      }
    },
    "/v1/containers": {
      "get": {
        "operationId": "listContainers",
        "summary": "List DEV Docker containers with bounded pagination",
        "parameters": [
          {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 50, "default": 12}},
          {"name": "cursor", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "all", "in": "query", "required": false, "schema": {"type": "boolean", "default": false}},
          {"name": "status", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "label", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "name", "in": "query", "required": false, "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "Container inventory"}}
      }
    },
    "/v1/containers/{container}": {
      "get": {
        "operationId": "inspectContainer",
        "summary": "Inspect a DEV container with redacted details",
        "parameters": [{"name": "container", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Container details"}, "404": {"description": "Not found"}}
      }
    },
    "/v1/containers/{container}/logs": {
      "get": {
        "operationId": "containerLogs",
        "summary": "Read bounded DEV container logs",
        "parameters": [
          {"name": "container", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "tail", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 2000, "default": 200}},
          {"name": "since", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 0}},
          {"name": "limit_bytes", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1024, "maximum": 262144, "default": 65536}}
        ],
        "responses": {"200": {"description": "Logs"}, "401": {"description": "Unauthorized"}, "404": {"description": "Not found"}}
      }
    },
    "/v1/containers/{container}/exec": {
      "post": {
        "operationId": "execContainer",
        "summary": "Run bounded argv in a DEV container through enforced mediation",
        "parameters": [{"name": "container", "in": "path", "required": true, "schema": {"type": "string"}}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CommandRequest"}}}},
        "responses": {"200": {"description": "Execution result"}, "400": {"description": "Bad request"}, "401": {"description": "Unauthorized"}, "403": {"description": "Denied"}, "409": {"description": "Observation or review required"}}
      }
    },
    "/v1/exec/run": {
      "post": {
        "operationId": "exec",
        "summary": "Run a bounded command in a registered DEV target",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExecRunRequest"}}}},
        "responses": {"200": {"description": "Execution result"}, "400": {"description": "Bad request"}, "401": {"description": "Unauthorized"}, "404": {"description": "Target not found"}, "409": {"description": "Blocked by enforced mediation/guidance"}}
      }
    },
    "/v1/sessions": {
      "post": {
        "operationId": "startSession",
        "summary": "Start a bounded non-TTY DEV session",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExecRunRequest"}}}},
        "responses": {"201": {"description": "Created"}, "400": {"description": "Bad request"}, "409": {"description": "Blocked"}}
      }
    },
    "/v1/sessions/{sessionId}": {
      "get": {
        "operationId": "getSession",
        "summary": "Read DEV session state",
        "parameters": [{"name": "sessionId", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Session"}, "404": {"description": "Not found"}}
      }
    },
    "/v1/sessions/{sessionId}/output": {
      "get": {
        "operationId": "readSession",
        "summary": "Read bounded DEV session stdout/stderr",
        "parameters": [
          {"name": "sessionId", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "after_seq", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 0, "default": 0}},
          {"name": "limit_bytes", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 256, "maximum": 8192, "default": 8192}}
        ],
        "responses": {"200": {"description": "Output"}}
      }
    },
    "/v1/sessions/{sessionId}/input": {
      "post": {
        "operationId": "writeSession",
        "summary": "Write stdin to a running DEV session",
        "parameters": [{"name": "sessionId", "in": "path", "required": true, "schema": {"type": "string"}}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SessionInput"}}}},
        "responses": {"200": {"description": "OK"}, "409": {"description": "Blocked"}}
      }
    },
    "/v1/sessions/{sessionId}/terminate": {
      "post": {
        "operationId": "terminateSession",
        "summary": "Terminate a managed DEV session",
        "parameters": [{"name": "sessionId", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Terminated"}, "409": {"description": "Blocked"}}
      }
    },
    "/v1/lesson-review": {
      "get": {
        "operationId": "getLessonReview",
        "summary": "Check whether resolved DEV errors should be promoted to reusable VERIFIED lessons",
        "responses": {"200": {"description": "Lesson review reminder and resolved candidates"}}
      }
    },
    "/v1/lesson-candidates": {
      "get": {
        "operationId": "listLessonCandidates",
        "summary": "List durable DEV incident/solution candidates",
        "parameters": [{"name": "status", "in": "query", "required": false, "schema": {"type": "string", "enum": ["OPEN", "RESOLVED", "RECORDED"]}}],
        "responses": {"200": {"description": "Candidate queue"}}
      }
    },
    "/v1/lesson-review/record": {
      "post": {
        "operationId": "recordLesson",
        "summary": "Record a VERIFIED reusable lesson from resolved DEV candidates",
        "description": "Use only resolved candidates. Generalize a portable behavior pattern; evidence is bound server-side. Lessons are advisory and never authorize mutation.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RecordLessonRequest"}}}},
        "responses": {"200": {"description": "VERIFIED lesson recorded"}, "400": {"description": "Invalid or unresolved candidate"}}
      }
    },
    "/v1/lessons": {
      "get": {
        "operationId": "listLessons",
        "summary": "List durable DEV lessons",
        "parameters": [
          {"name": "status", "in": "query", "required": false, "schema": {"type": "string", "enum": ["PROPOSED", "VERIFIED", "RETIRED"]}},
          {"name": "problem_class", "in": "query", "required": false, "schema": {"type": "string", "maxLength": 80}}
        ],
        "responses": {"200": {"description": "Lesson list"}}
      }
    },
    "/v1/lessons/{lessonId}": {
      "get": {
        "operationId": "getLesson",
        "summary": "Read one durable DEV lesson",
        "parameters": [{"name": "lessonId", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 120}}],
        "responses": {"200": {"description": "Lesson"}, "404": {"description": "Not found"}}
      }
    },
    "/v1/lessons/recommend": {
      "post": {
        "operationId": "recommendLessons",
        "summary": "Retrieve relevant VERIFIED DEV lessons for observed technical signals",
        "description": "Observe-first advisory retrieval. Historical lessons never authorize mutation.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LessonRecommendRequest"}}}},
        "responses": {"200": {"description": "Relevant lesson matches"}}
      }
    },
    "/v1/self-protection": {
      "get": {
        "operationId": "getSelfProtection",
        "summary": "Read DEV self-protection status",
        "responses": {"200": {"description": "Self-protection status"}}
      }
    },
    "/v1/approval/prepare": {
      "post": {
        "operationId": "prepareChange",
        "summary": "Prepare immutable DEV change request through enforced server-derived preflight",
        "description": "Caller intent/risk claims do not authorize a change. This call may be blocked before any request is created.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApprovalPrepareRequest"}}}},
        "responses": {"200": {"description": "Prepared request"}, "400": {"description": "Bad request"}, "409": {"description": "Observation/review required or stale"}}
      }
    },
    "/v1/approval/status": {
      "get": {
        "operationId": "approvalStatus",
        "summary": "Read immutable DEV approval request status",
        "parameters": [{"name": "request_id", "in": "query", "required": true, "schema": {"type": "string", "minLength": 1}}],
        "responses": {"200": {"description": "Approval status"}, "404": {"description": "Not found"}}
      }
    },
    "/v1/target/file/canary": {
      "post": {
        "operationId": "createTargetCanaryFile",
        "summary": "Create one exclusive disposable canary file in an allowlisted DEV target",
        "description": "Purpose-built reversible verification primitive. Creation is mediated server-side and fails if the path already exists.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CanaryCreateRequest"}}}},
        "responses": {"200": {"description": "Canary created with SHA-256 readback evidence"}, "400": {"description": "Bad request"}, "404": {"description": "Target not found"}, "409": {"description": "Blocked, stale, or path already exists"}}
      },
      "delete": {
        "operationId": "deleteTargetCanaryFile",
        "summary": "Delete only a matching disposable canary file from an allowlisted DEV target",
        "description": "Stale-safe cleanup primitive. expected_sha256 must match the current file before deletion; successful response verifies absence.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CanaryDeleteRequest"}}}},
        "responses": {"200": {"description": "Canary deleted and absence verified"}, "400": {"description": "Bad request"}, "404": {"description": "Target or file not found"}, "409": {"description": "Blocked or SHA mismatch"}}
      }
    }
  },
  "components": {
    "schemas": {
      "CanaryCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "path", "content"],
        "properties": {
          "target_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "path": {"type": "string", "minLength": 1, "maxLength": 512},
          "content": {"type": "string", "minLength": 1, "maxLength": 4096}
        }
      },
      "CanaryDeleteRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "path", "expected_sha256"],
        "properties": {
          "target_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "path": {"type": "string", "minLength": 1, "maxLength": 512},
          "expected_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      },
      "Command": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "maxLength": 2048}},
      "CommandRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cmd"],
        "properties": {
          "cmd": {"$ref": "#/components/schemas/Command"},
          "working_dir": {"type": "string", "maxLength": 512},
          "timeout_ms": {"type": "integer", "minimum": 100, "maximum": 120000, "default": 30000}
        }
      },
      "ExecRunRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "cmd"],
        "properties": {
          "target_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "cmd": {"$ref": "#/components/schemas/Command"},
          "working_dir": {"type": "string", "maxLength": 512},
          "timeout_ms": {"type": "integer", "minimum": 100, "maximum": 120000, "default": 30000}
        }
      },
      "SessionInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {"data": {"type": "string"}, "data_base64": {"type": "string"}},
        "oneOf": [{"required": ["data"]}, {"required": ["data_base64"]}]
      },
      "ApprovalArgs": {
        "type": "object",
        "description": "Optional bounded operation arguments. The server hashes the complete object into the immutable request.",
        "properties": {
          "target_id": {"type": "string", "maxLength": 160},
          "candidate_sha": {"type": "string", "maxLength": 80},
          "config_digest": {"type": "string", "maxLength": 128},
          "image": {"type": "string", "maxLength": 240},
          "branch": {"type": "string", "maxLength": 160},
          "force": {"type": "boolean"}
        },
        "additionalProperties": true
      },
      "ApprovalObservedState": {
        "type": "object",
        "description": "Observed pre-change state used for stale-request protection.",
        "properties": {
          "generation": {"type": "integer"},
          "status": {"type": "string", "maxLength": 120},
          "state": {"type": "string", "maxLength": 120},
          "config_hash": {"type": "string", "maxLength": 128},
          "image": {"type": "string", "maxLength": 240},
          "commit_sha": {"type": "string", "maxLength": 80}
        },
        "additionalProperties": true
      },
      "ApprovalPrepareRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource", "operation"],
        "properties": {
          "resource": {"type": "string", "minLength": 1, "maxLength": 200, "description": "Exact DEV resource selector. Wildcards are rejected server-side."},
          "operation": {"type": "string", "minLength": 1, "maxLength": 80, "description": "Requested operation. Risk/effect are derived server-side; caller labels do not authorize it."},
          "args": {"$ref": "#/components/schemas/ApprovalArgs"},
          "observed_state": {"$ref": "#/components/schemas/ApprovalObservedState"},
          "reason": {"type": "string", "maxLength": 500},
          "ttl_ms": {"type": "integer", "minimum": 5000, "maximum": 900000}
        }
      },
      "RecordLessonRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_ids", "lesson"],
        "properties": {
          "candidate_ids": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
          "lesson": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "problem_class", "scope", "signals", "recommendations", "rationale"],
            "properties": {
              "lesson_id": {"type": "string", "minLength": 1, "maxLength": 120},
              "title": {"type": "string", "minLength": 1, "maxLength": 160},
              "problem_class": {"type": "string", "minLength": 2, "maxLength": 80},
              "scope": {"type": "object", "additionalProperties": false, "required": ["target_class"], "properties": {"target_class": {"type": "string", "minLength": 1, "maxLength": 100}}},
              "signals": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
              "recommendations": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 320}},
              "rationale": {"type": "string", "minLength": 1, "maxLength": 600}
            }
          }
        }
      },
      "LessonRecommendRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "signals"],
        "properties": {
          "problem_class": {"type": "string", "maxLength": 80},
          "scope": {"type": "object", "additionalProperties": false, "required": ["target_class"], "properties": {"target_class": {"type": "string", "minLength": 1, "maxLength": 100}}},
          "signals": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
          "limit": {"type": "integer", "minimum": 1, "maximum": 10, "default": 5},
          "min_score": {"type": "integer", "minimum": 1, "maximum": 100, "default": 4}
        }
      }
    },
    "securitySchemes": {
      "Bearer": {"type": "http", "scheme": "bearer", "bearerFormat": "opaque"}
    }
  }
}