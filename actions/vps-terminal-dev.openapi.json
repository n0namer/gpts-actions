 reusable lessons for similar technical signals","description":"Recommendations are advisory only. Always observe current runtime before acting; historical lessons never authorize mutation.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["scope","signals"],"properties":{"problem_class":{"type":"string","maxLength":80},"scope":{"type":"object","additionalProperties":false,"required":["target_class"],"properties":{"target_class":{"type":"string","minLength":1,"maxLength":100}}},"signals":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"string","minLength":1,"maxLength":160}},"limit":{"type":"integer","minimum":1,"maximum":10,"default":5},"min_score":{"type":"integer","minimum":1,"maximum":100,"default":4}}}}}},"responses":{"200":{"description":"Advisory observe-first lesson matches"}}}}},"components":{"schemas":{"Command":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"string","maxLength":2048}},"ExecRunRequest":{"type":"object","additionalProperties":false,"required":["target_id","cmd"],"properties":{"target_id":{"type":"string","minLength":1,"maxLength":128,"description":"Registered target id, or debug:<uuid> for an existing debug target."},"cmd":{"$ref":"#/components/schemas/Command"},"working_dir":{"type":"string","maxLength":512},"timeout_ms":{"type":"integer","minimum":100,"maximum":120000,"default":30000}}},"SessionStartRequest":{"type":"object","additionalProperties":false,"required":["target_id","cmd"],"properties":{"target_id":{"type":"string","minLength":1,"maxLength":128,"description":"Registered target id, or debug:<uuid> for an existing debug target."},"cmd":{"$ref":"#/components/schemas/Command"},"working_dir":{"type":"string","maxLength":512}}},"SessionInput":{"type":"object","additionalProperties":false,"properties":{"data":{"type":"string"},"data_base64":{"type":"string"}},"oneOf":[{"required":["data"]},{"required":["data_base64"]}]}},"securitySch