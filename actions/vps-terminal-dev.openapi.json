    "/v1/target/check": {
      "post": {
        "operationId": "runTargetCheck",
        "summary": "Run target-owned validation preset after DEV live patch",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "target_id",
                  "preset"
