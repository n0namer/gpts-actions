  "components": {
    "schemas": {
      "Command": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "CommandRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cmd"
        ],
        "properties": {
          "cmd": {
            "$ref": "#/components/schemas/Command"
          },
          "working_dir": {
            "type": "string",
            "maxLength": 512
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 120000,
            "default": 30000
          }
        }
      },
      "SessionStartRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "cmd"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "cmd": {
            "$ref": "#/components/schemas/Command"
          },
          "working_dir": {
            "type": "string",
            "maxLength": 512
          }
        }
      },
      "ExecRunRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "cmd"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "cmd": {
            "$ref": "#/components/schemas/Command"
          },
          "working_dir": {
            "type": "string",
            "maxLength": 512
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 120000,
            "default": 30000
          }
        }
      },
      "SessionInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "string"
          },
          "data_base64": {
            "type": "string"
          }
        },
        "oneOf": [
          {
            "required": [
              "data"
            ]
          },
          {
            "required": [
              "data_base64"
            ]
          }
        ]
      },
      "FileActionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "target_id", "path"],
        "description": "Closed file-action envelope. read may use start_line/line_count/max_bytes; create requires content; preview_patch and apply_patch require expected_sha256/old_text/new_text; delete requires expected_sha256. The server rejects fields that do not belong to the selected operation.",
        "properties": {
          "operation": {
            "type": "string",
            "enum": ["read", "create", "preview_patch", "apply_patch", "delete"]
          },
          "target_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^/"},
          "start_line": {"type": "integer", "minimum": 1, "default": 1},
          "line_count": {"type": "integer", "minimum": 1, "maximum": 200, "default": 120},
          "max_bytes": {"type": "integer", "minimum": 256, "maximum": 12000, "default": 8192},
          "content": {"type": "string", "maxLength": 4096},
          "expected_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "old_text": {"type": "string", "minLength": 1, "maxLength": 12000},
          "new_text": {"type": "string", "maxLength": 12000}
        }
      },
      "TargetWritebackRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "change_id",
          "status"
        ],
        "properties": {
          "change_id": {
            "type": "string",
            "pattern": "^vtchg_[0-9a-f]{32}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "CANDIDATE",
              "ACCEPTED",
              "REJECTED"
            ]
          },
          "branch": {
            "type": "string",
            "maxLength": 200
          },
          "commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40,64}$"
          },
          "pr_number": {
            "type": "integer",
            "minimum": 1
          },
          "merged_sha": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40,64}$"
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "ApprovalArgs": {
        "type": "object",
        "description": "Optional bounded operation arguments. The server hashes the complete object into the immutable request.",
        "properties": {
          "target_id": {
            "type": "string",
            "maxLength": 160
          },
          "candidate_sha": {
            "type": "string",
            "maxLength": 80
          },
          "config_digest": {
            "type": "string",
            "maxLength": 128
          },
          "image": {
            "type": "string",
            "maxLength": 240
          },
          "branch": {
            "type": "string",
            "maxLength": 160
          },
          "force": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      },
      "ApprovalObservedState": {
        "type": "object",
        "description": "Observed pre-change state used for stale-request protection.",
        "properties": {
          "generation": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "maxLength": 120
          },
          "state": {
            "type": "string",
            "maxLength": 120
          },
          "config_hash": {
            "type": "string",
            "maxLength": 128
          },
          "image": {
            "type": "string",
            "maxLength": 240
          },
          "commit_sha": {
            "type": "string",
            "maxLength": 80
          }
        },
        "additionalProperties": true
      },
      "ApprovalPrepareRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource",
          "operation"
        ],
        "properties": {
          "resource": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Exact DEV resource selector. Wildcards are rejected server-side."
          },
          "operation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Requested operation. Risk/effect are derived server-side; caller labels do not authorize it."
          },
          "args": {
            "$ref": "#/components/schemas/ApprovalArgs"
          },
          "observed_state": {
            "$ref": "#/components/schemas/ApprovalObservedState"
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          },
          "ttl_ms": {
            "type": "integer",
            "minimum": 5000,
            "maximum": 900000
          }
        }
      },
      "ProposedLessonRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lesson_id",
          "title",
          "problem_class",
          "scope",
          "signals",
          "recommendations",
          "rationale",
          "origin"
        ],
        "properties": {
          "lesson_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "problem_class": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target_class"
            ],
            "properties": {
              "target_class": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            }
          },
          "signals": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "recommendations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 320
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "CHAT_IMPORT",
                  "DOC_IMPORT"
                ]
              },
              "source_confidence": {
                "type": "string",
                "enum": [
                  "VERIFIED",
                  "LIKELY",
                  "MEMORY_ONLY"
                ]
              },
              "source_refs": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "maxLength": 240
                }
              }
            }
          }
        }
      },
      "RecordLessonRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_ids",
          "lesson"
        ],
        "properties": {
          "candidate_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "lesson": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "problem_class",
              "scope",
              "signals",
              "recommendations",
              "rationale"
            ],
            "properties": {
              "lesson_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "problem_class": {
                "type": "string",
                "minLength": 2,
                "maxLength": 80
              },
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "target_class"
                ],
                "properties": {
                  "target_class": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                }
              },
              "signals": {
                "type": "array",
                "minItems": 1,
                "maxItems": 24,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              },
              "recommendations": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 320
                }
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              }
            }
          }
        }
      },
      "LessonRecommendRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "signals"
        ],
        "properties": {
          "problem_class": {
            "type": "string",
            "maxLength": 80
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target_class"
            ],
            "properties": {
              "target_class": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            }
          },
          "signals": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 5
          },
          "min_score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 4
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque"
      }
    }
  }
}
