                      "python_compile",
                      "node_check",
                      "git_diff_check",
                      "pytest_q"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "maxLength": 512
                  }
                }
              }
            }
          }
        },
        "responses": {
