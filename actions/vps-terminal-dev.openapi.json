          "200": {
            "description": "Execution result"
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Denied"
          },
          "409": {
            "description": "Observation or review required"
          }
        }
      }
    },
    "/v1/capabilities/octocode/research": {
      "post": {
        "operationId": "octocodeResearch",
        "summary": "Run target-fixed remote read-only code research through pinned Octocode",
        "description": "CAP-002 typed research lane. The server fixes target to openclaw-main and the Octocode executable/version; callers can select only an allowlisted remote read-only tool and bounded JSON queries. This operation does not expose a shell, caller-selected target, local search or repository clone.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["tool", "queries"],
                "properties": {
                  "tool": {"type": "string", "enum": ["ghSearchCode", "ghSearchRepos", "ghSearchPullRequests", "ghSearchIssues", "ghSearchCommits", "ghGetFileContent", "ghViewRepoStructure", "npmSearch"]},
                  "queries": {
                    "oneOf": [{"type": "object"}, {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "object"}}],
                    "description": "Bounded Octocode query object or 1..5 query objects. Server enforces a maximum serialized size of 1800 bytes."
                  },
                  "timeout_ms": {"type": "integer", "minimum": 1000, "maximum": 60000, "default": 30000}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Structured read-only research result"},
          "400": {"description": "Invalid or denied tool/query input"},
          "401": {"description": "Unauthorized"},
          "409": {"description": "Pinned Octocode version mismatch or mediation conflict"},
          "413": {"description": "Serialized queries exceed the server bound"},
          "502": {"description": "Structured Octocode output invalid or truncated"}
        }
      }
    },
    "/v1/exec/run": {
      "post": {
