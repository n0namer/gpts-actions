{
  "openapi": "3.1.0",
  "info": {
    "title": "VPS Terminal - Dev",
    "version": "0.7.0-dev.7",
    "description": "DEV ONLY. Compact GPT-facing VPS Terminal surface with 29 high-value operations. Adds one closed targetRegistryAction family (read|upsert) over the existing mediated TargetRegistry ACI so GPT can inspect and stale-safely update allowlisted DEV target definitions without shell/config-file bypass. Five bounded file capabilities remain multiplexed through fileAction. Backend branch validation, stale-SHA/root/capability guards, mediation and readback remain authoritative; no generic args or shell dispatcher is exposed. Runtime-file journal/write-back lifecycle and lower-priority administration remain intentionally omitted from this publication."
  },
  "servers": [
    {
      "url": "https://vps-terminal-dev.srv1904412.hstgr.cloud"
    }
  ],
  "security": [
    {
      "Bearer": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Check DEV VPS Terminal liveness",
        "security": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready",
        "summary": "Check DEV VPS Terminal and Docker readiness",
        "security": [],
        "responses": {
          "200": {
            "description": "Ready"
          },
          "503": {
            "description": "Not ready"
          }
        }
      }
    },
    "/api/v1/version": {
      "get": {
        "operationId": "version",
        "summary": "Read DEV service version, guidance, mediation and durable-plane status",
        "responses": {
          "200": {
            "description": "Version and runtime status"
          },
          "503": {
            "description": "Startup self-test not ready"
          }
        }
      }
    },
    "/v1/target/file/action": {
      "post": {
        "operationId": "fileAction",
        "summary": "Run one bounded DEV file operation",
        "description": "Closed file-operation family: read, create, preview_patch, apply_patch, delete. The server enforces branch-specific fields plus root, capability, stale-SHA, mediation and readback guards. No arbitrary args or shell command is accepted.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FileActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Bounded file operation result"},
          "400": {"description": "Invalid operation, field set or request"},
          "403": {"description": "Target capability or policy denied"},
          "404": {"description": "Target or file not found"},
          "409": {"description": "Stale SHA, existing path or policy conflict"},
          "502": {"description": "Readback verification failed"}
        }
      }
    },
