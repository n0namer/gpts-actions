{
  "openapi": "3.1.0",
  "info": {
    "title": "LAN Ops DEV Broker",
    "version": "0.3.0-dev",
    "description": "Isolated authenticated LAN Ops DEV operator plane over a private Edge. It exposes bounded one-shot Windows command execution and managed terminal sessions for multi-chat development acceptance while keeping PROD separate."
  },
  "servers": [
    {
      "url": "https://lan-ops-dev.srv1904412.hstgr.cloud"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getLanOpsDevHealth",
        "summary": "Check LAN Ops DEV broker, edge and runner availability.",
        "x-openai-isConsequential": false,
        "responses": {
          "200": {
            "description": "DEV health state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/exec": {
      "post": {
        "operationId": "runLanDevCommand",
        "summary": "Run one bounded command on the DEV Windows Runner pool.",
        "description": "Executes argv directly on the isolated DEV Personal Edge Runner and returns bounded stdout, stderr, exit code, duration, timeout and truncation state.",
        "x-openai-isConsequential": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExecRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Command completed or timed out.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecResult"
                }
              }
            }
          },
          "429": {
            "description": "DEV broker concurrency capacity is exhausted."
          }
        }
      }
    },
    "/v1/sessions": {
      "post": {
        "operationId": "startLanDevTerminalSession",
        "summary": "Start a managed terminal process on the DEV Windows Runner pool.",
        "x-openai-isConsequential": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionStart"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session started.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionState"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}": {
      "get": {
        "operationId": "getLanDevTerminalSession",
        "summary": "Read DEV managed terminal session state.",
        "x-openai-isConsequential": false,
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "description": "Managed DEV terminal session identifier returned by startLanDevTerminalSession.",
            "schema": {
              "type": "string",
              "pattern": "^sess_[A-Za-z0-9]{8,64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionState"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}/read": {
      "get": {
        "operationId": "readLanDevTerminalSession",
        "summary": "Read bounded stdout and stderr chunks from a DEV terminal session.",
        "x-openai-isConsequential": false,
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionId"
          },
          {
            "name": "after_seq",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "limit_bytes",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 2048,
              "maximum": 65536,
              "default": 8192
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session output chunks.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionRead"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}/write": {
      "post": {
        "operationId": "writeLanDevTerminalSession",
        "summary": "Write UTF-8 or base64 stdin to a running DEV terminal session.",
        "x-openai-isConsequential": true,
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionWrite"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted input with monotonic sequence and integrity hash.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionWriteResult"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}/terminate": {
      "post": {
        "operationId": "terminateLanDevTerminalSession",
        "summary": "Terminate a DEV managed terminal session.",
        "x-openai-isConsequential": true,
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionId"
          }
        ],
        "responses": {
          "200": {
            "description": "Terminated session state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionState"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "SessionId": {
        "name": "session_id",
        "in": "path",
        "required": true,
        "description": "Managed DEV terminal session identifier returned by startLanDevTerminalSession.",
        "schema": {
          "type": "string",
          "pattern": "^sess_[A-Za-z0-9]{8,64}$"
        }
      }
    },
    "schemas": {
      "ExecRequest": {
        "type": "object",
        "required": [
          "cmd"
        ],
        "additionalProperties": false,
        "properties": {
          "cmd": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "description": "Command argv. The first item is the executable; no implicit shell is added.",
            "items": {
              "type": "string",
              "maxLength": 2048
            }
          },
          "working_dir": {
            "type": "string",
            "maxLength": 512
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 1800000,
            "default": 300000
          }
        }
      },
      "ExecResult": {
        "type": "object",
        "required": [
          "status",
          "stdout",
          "stderr",
          "duration_ms",
          "timed_out",
          "truncated"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "timeout"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "timed_out": {
            "type": "boolean"
          },
          "truncated": {
            "type": "boolean"
          }
        }
      },
      "SessionStart": {
        "type": "object",
        "required": [
          "cmd"
        ],
        "additionalProperties": false,
        "properties": {
          "cmd": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 2048
            }
          },
          "working_dir": {
            "type": "string",
            "maxLength": 512
          }
        }
      },
      "SessionState": {
        "type": "object",
        "required": [
          "session_id",
          "status",
          "running",
          "created_at",
          "updated_at",
          "next_seq",
          "truncated",
          "dropped_before_seq"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^sess_[A-Za-z0-9]{8,64}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "completed",
              "terminated"
            ]
          },
          "running": {
            "type": "boolean"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "created_at": {
            "type": "integer"
          },
          "updated_at": {
            "type": "integer"
          },
          "next_seq": {
            "type": "integer",
            "minimum": 0
          },
          "truncated": {
            "type": "boolean"
          },
          "dropped_before_seq": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "SessionChunk": {
        "type": "object",
        "required": [
          "seq",
          "stream",
          "data"
        ],
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 1
          },
          "stream": {
            "type": "string",
            "enum": [
              "stdout",
              "stderr"
            ]
          },
          "data": {
            "type": "string"
          }
        }
      },
      "SessionRead": {
        "type": "object",
        "required": [
          "session_id",
          "status",
          "running",
          "created_at",
          "updated_at",
          "next_seq",
          "truncated",
          "dropped_before_seq",
          "chunks",
          "has_more"
        ],
        "properties": {
          "session_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "completed",
              "terminated"
            ]
          },
          "running": {
            "type": "boolean"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "created_at": {
            "type": "integer"
          },
          "updated_at": {
            "type": "integer"
          },
          "next_seq": {
            "type": "integer"
          },
          "truncated": {
            "type": "boolean"
          },
          "dropped_before_seq": {
            "type": "integer"
          },
          "chunks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionChunk"
            }
          },
          "has_more": {
            "type": "boolean"
          }
        }
      },
      "SessionWrite": {
        "type": "object",
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "data"
            ]
          },
          {
            "required": [
              "data_base64"
            ]
          }
        ],
        "properties": {
          "data": {
            "type": "string",
            "maxLength": 8192,
            "description": "UTF-8 stdin represented as text."
          },
          "data_base64": {
            "type": "string",
            "maxLength": 16384,
            "description": "Base64-encoded stdin bytes for non-text input."
          }
        }
      },
      "SessionWriteResult": {
        "type": "object",
        "required": [
          "session_id",
          "accepted_bytes",
          "input_seq",
          "input_sha256",
          "status"
        ],
        "properties": {
          "session_id": {
            "type": "string"
          },
          "accepted_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "input_seq": {
            "type": "integer",
            "minimum": 1
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "healthy"
            ]
          },
          "trace_id": {
            "type": "string"
          },
          "environment": {
            "type": "string",
            "enum": [
              "dev"
            ]
          },
          "source_sha": {
            "type": "string"
          },
          "max_concurrent": {
            "type": "integer",
            "minimum": 1
          },
          "edge": {
            "type": "string"
          }
        }
      }
    }
  }
}
