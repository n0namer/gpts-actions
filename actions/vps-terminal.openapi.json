{
  "openapi": "3.1.0",
  "info": {
    "title": "VPS Terminal",
    "version": "0.4.0",
    "description": "Bounded target-aware terminal API for GPT Actions. Static targets are selected by the server-side target registry and x-vps-target-id binding; debug clones are isolated, TTL-bounded targets created only from explicitly permitted sources."
  },
  "servers": [
    {
      "url": "https://vps-terminal.srv1904412.hstgr.cloud"
    }
  ],
  "security": [
    {
      "Bearer": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "security": [],
        "summary": "Check VPS Terminal liveness",
        "responses": {
          "200": {
            "description": "Live",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "service", "gateway", "upstream"],
                  "properties": {
                    "status": {"type": "string"},
                    "service": {"type": "string"},
                    "gateway": {"type": "string"},
                    "upstream": {
                      "type": "object",
                      "required": ["service", "version"],
                      "properties": {
                        "service": {"type": "string"},
                        "version": {"type": ["string", "null"]}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },

    "/ready": {
      "get": {
        "operationId": "ready",
        "security": [],
        "summary": "Check VPS Terminal and Docker readiness",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/version": {
      "get": {
        "operationId": "version",
        "summary": "Read service version information",
        "responses": {
          "200": {
            "description": "Version",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["service", "upstream"],
                  "properties": {
                    "service": {"type": "string"},
                    "upstream": {
                      "type": "object",
                      "properties": {
                        "agentVersion": {"type": "string"},
                        "protocolName": {"type": "string"},
                        "protocolVersion": {"type": "string"},
                        "adapter": {"type": "string"}
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/target/logs": {"get":{"operationId":"targetLogs","summary":"Read bounded logs for the bound target","description":"Requires x-vps-target-id. Target resolution is server-side; callers cannot supply a container id.","parameters":[{"$ref":"#/components/parameters/TargetId"},{"name":"tail","in":"query","schema":{"type":"integer","minimum":1,"maximum":2000,"default":200}},{"name":"since","in":"query","schema":{"type":"integer","minimum":0,"maximum":2147483647}},{"name":"limit_bytes","in":"query","schema":{"type":"integer","minimum":1024,"maximum":262144,"default":65536}}],"responses":{"200":{"description":"Bounded target logs","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TargetLogs"}}}},"400":{"$ref":"#/components/responses/Error"},"401":{"$ref":"#/components/responses/Error"},"404":{"$ref":"#/components/responses/Error"},"409":{"$ref":"#/components/responses/Error"},"502":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
    "/v1/target/stats": {"get":{"operationId":"targetStats","summary":"Read compact resource stats for the bound target","parameters":[{"$ref":"#/components/parameters/TargetId"}],"responses":{"200":{"description":"Target stats","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TargetStats"}}}},"400":{"$ref":"#/components/responses/Error"},"401":{"$ref":"#/components/responses/Error"},"404":{"$ref":"#/components/responses/Error"},"409":{"$ref":"#/components/responses/Error"},"502":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
    "/v1/debug-clones": {"post":{"operationId":"createDebugClone","summary":"Create an isolated TTL-bounded debug clone","description":"Requires a static x-vps-target-id permitted for debug_clone. Networking is disabled and selected named source volumes are mounted read-only.","parameters":[{"$ref":"#/components/parameters/TargetId"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DebugCloneCreate"}}}},"responses":{"201":{"description":"Debug clone created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DebugClone"}}}},"400":{"$ref":"#/components/responses/Error"},"401":{"$ref":"#/components/responses/Error"},"404":{"$ref":"#/components/responses/Error"},"409":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"502":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
    "/v1/debug-clones/{debugId}": {"get":{"operationId":"getDebugClone","summary":"Inspect a managed debug clone","parameters":[{"$ref":"#/components/parameters/DebugId"}],"responses":{"200":{"description":"Debug clone state","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DebugClone"}}}},"401":{"$ref":"#/components/responses/Error"},"404":{"$ref":"#/components/responses/Error"},"409":{"$ref":"#/components/responses/Error"},"502":{"$ref":"#/components/responses/Error"}}},"delete":{"operationId":"deleteDebugClone","summary":"Delete a managed debug clone and verify absence","parameters":[{"$ref":"#/components/parameters/DebugId"}],"responses":{"200":{"description":"Deletion result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DebugCloneDelete"}}}},"401":{"$ref":"#/components/responses/Error"},"409":{"$ref":"#/components/responses/Error"},"502":{"$ref":"#/components/responses/Error"}}}},
    "/v1/containers": {
      "get": {
        "operationId": "listContainers",
        "summary": "List running containers with bounded cursor pagination",
        "description": "Read-only operational inventory. Terminal execution cannot target these arbitrary container identifiers.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 12
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque continuation cursor.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "label",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContainerPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/containers/{container}": {
      "get": {
        "operationId": "inspectContainer",
        "summary": "Read compact redacted container details",
        "parameters": [
          {
            "name": "container",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "Compact redacted detail",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "name", "image", "created", "restart_count", "state", "health", "network_mode", "networks", "mounts"],
                  "properties": {
                    "id": {"type": "string"},
                    "name": {"type": "string"},
                    "image": {"type": "string"},
                    "created": {"type": "string"},
                    "restart_count": {"type": "integer"},
                    "state": {
                      "type": "object",
                      "properties": {
                        "status": {"type": "string"},
                        "running": {"type": "boolean"},
                        "paused": {"type": "boolean"},
                        "restarting": {"type": "boolean"},
                        "oom_killed": {"type": "boolean"},
                        "dead": {"type": "boolean"},
                        "pid": {"type": "integer"},
                        "exit_code": {"type": "integer"},
                        "error": {"type": "string"}
                      }
                    },
                    "health": {
                      "type": ["object", "null"],
                      "properties": {
                        "status": {"type": "string"},
                        "failing_streak": {"type": "integer"}
                      }
                    },
                    "network_mode": {"type": "string"},
                    "networks": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {"type": "string"},
                          "ip": {"type": "string"},
                          "gateway": {"type": "string"}
                        }
                      }
                    },
                    "mounts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {"type": "string"},
                          "destination": {"type": "string"},
                          "rw": {"type": "boolean"},
                          "volume_name": {"type": "string"}
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/exec/run": {
      "post": {
        "operationId": "exec",
        "summary": "Run a bounded command in the canonical Workbench",
        "description": "The server selects the single neutral Workbench target. The caller cannot choose a container. Returns separated stdout and stderr, exit code, duration, timeout state, and truncation state.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExecRunRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Execution result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecRunResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/sessions": {
      "post": {
        "operationId": "startSession",
        "summary": "Start a managed terminal session in the canonical Workbench",
        "description": "Starts a bounded non-TTY session with readable stdout/stderr and writable stdin. The caller cannot choose a container.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionStartRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session started",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionState"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/sessions/{sessionId}": {
      "get": {
        "operationId": "getSession",
        "summary": "Read managed terminal session state",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "Session state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionState"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/sessions/{sessionId}/output": {
      "get": {
        "operationId": "readSession",
        "summary": "Read bounded stdout/stderr chunks from a managed session",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          },
          {
            "name": "after_seq",
            "in": "query",
            "required": false,
            "description": "Return chunks whose seq is greater than this value.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "limit_bytes",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 256,
              "maximum": 8192,
              "default": 8192
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Output page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOutput"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/sessions/{sessionId}/input": {
      "post": {
        "operationId": "writeSession",
        "summary": "Write stdin to a running managed session",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Input accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionWriteResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/sessions/{sessionId}/terminate": {
      "post": {
        "operationId": "terminateSession",
        "summary": "Terminate a managed terminal session",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "Terminated session state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionState"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Container": {
        "name": "container",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "SessionId": {"name":"sessionId","in":"path","required":true,"schema":{"type":"string"}},
      "TargetId": {"name":"x-vps-target-id","in":"header","required":true,"description":"Registered static target id, or debug:<uuid> where the operation permits an existing debug target.","schema":{"type":"string","minLength":1,"maxLength":128}},
      "DebugId": {"name":"debugId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}
    },
    "schemas": {
      "Ready": {
        "type": "object",
        "required": [
          "ready",
          "service",
          "docker"
        ],
        "properties": {
          "ready": {
            "type": "boolean"
          },
          "service": {
            "type": "string"
          },
          "docker": {
            "type": "object",
            "required": [
              "connected",
              "status"
            ],
            "properties": {
              "connected": {
                "type": "boolean"
              },
              "status": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            }
          }
        }
      },
      "ContainerPage": {
        "type": "object",
        "required": [
          "items",
          "page"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "required": ["id", "name", "image", "created", "state", "status", "ports", "networks"],
              "properties": {
                "id": {"type": "string"},
                "name": {"type": "string"},
                "image": {"type": "string"},
                "created": {"type": "integer"},
                "state": {"type": "string"},
                "status": {"type": "string"},
                "ports": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "private_port": {"type": ["integer", "null"]},
                      "public_port": {"type": ["integer", "null"]},
                      "type": {"type": "string"}
                    }
                  }
                },
                "networks": {
                  "type": "array",
                  "items": {"type": "string"}
                }
              }
            }
          },
          "page": {
            "type": "object",
            "required": [
              "scope",
              "limit",
              "returned",
              "total",
              "has_more",
              "next_cursor"
            ],
            "properties": {
              "scope": {
                "type": "string",
                "enum": [
                  "running"
                ]
              },
              "limit": {
                "type": "integer"
              },
              "returned": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              },
              "has_more": {
                "type": "boolean"
              },
              "next_cursor": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "TargetLogs": {"type":"object","required":["target_id","tail","since","text","truncated","bytes"],"properties":{"target_id":{"type":"string"},"tail":{"type":"integer"},"since":{"type":["integer","null"]},"text":{"type":"string"},"truncated":{"type":"boolean"},"bytes":{"type":"integer","minimum":0}}},
      "TargetStats": {"type":"object","required":["target_id","read","memory","pids","cpu","network"],"properties":{"target_id":{"type":"string"},"read":{"type":["string","null"]},"memory":{"type":"object","properties":{"usage":{"type":"integer"},"limit":{"type":"integer"}}},"pids":{"type":"object","properties":{"current":{"type":"integer"}}},"cpu":{"type":"object","properties":{"total_usage":{"type":"integer"},"system_usage":{"type":"integer"},"online_cpus":{"type":"integer"}}},"network":{"type":"object","properties":{"rx_bytes":{"type":"integer"},"tx_bytes":{"type":"integer"}}}}},
      "DebugCloneCreate": {"type":"object","additionalProperties":false,"properties":{"mounts":{"type":"array","maxItems":8,"items":{"type":"string","maxLength":512},"default":[]}}},
      "DebugClone": {"type":"object","required":["debug_id","target_id","source_target_id","name","container_id","created_at","expires_at","status","mounts"],"properties":{"debug_id":{"type":"string","format":"uuid"},"target_id":{"type":"string"},"source_target_id":{"type":"string"},"name":{"type":"string"},"container_id":{"type":"string"},"created_at":{"type":"integer"},"expires_at":{"type":"integer"},"status":{"type":"string"},"mounts":{"type":"array","items":{"type":"object","properties":{"destination":{"type":"string"},"read_only":{"type":"boolean"}}}},"state":{"type":"object","properties":{"running":{"type":"boolean"},"status":{"type":"string"},"pid":{"type":"integer"},"exit_code":{"type":"integer"}}}}},
      "DebugCloneDelete": {"type":"object","required":["debug_id","deleted"],"properties":{"debug_id":{"type":"string"},"deleted":{"type":"boolean"},"verified_absent":{"type":"boolean"},"already_absent":{"type":"boolean"}}},
      "Command": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "ExecRunRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cmd"
        ],
        "properties": {
          "cmd": {
            "$ref": "#/components/schemas/Command"
          },
          "working_dir": {
            "type": "string",
            "maxLength": 512
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 120000,
            "default": 30000
          }
        }
      },
      "ExecRunResult": {
        "type": "object",
        "required": [
          "status",
          "exit_code",
          "stdout",
          "stderr",
          "duration_ms",
          "timed_out",
          "truncated"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "timeout"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "stdout": {
            "type": "string",
            "description": "Bounded stdout. Use managed sessions for larger or long-running output."
          },
          "stderr": {
            "type": "string",
            "description": "Bounded stderr."
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "timed_out": {
            "type": "boolean"
          },
          "truncated": {
            "type": "boolean"
          }
        }
      },
      "SessionStartRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cmd"
        ],
        "properties": {
          "cmd": {
            "$ref": "#/components/schemas/Command"
          },
          "working_dir": {
            "type": "string",
            "maxLength": 512
          }
        }
      },
      "SessionState": {
        "type": "object",
        "required": [
          "session_id",
          "status",
          "running",
          "exit_code",
          "created_at",
          "updated_at",
          "next_seq",
          "truncated",
          "dropped_before_seq"
        ],
        "properties": {
          "session_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "running": {
            "type": "boolean"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "created_at": {
            "type": "integer"
          },
          "updated_at": {
            "type": "integer"
          },
          "next_seq": {
            "type": "integer",
            "minimum": 0
          },
          "truncated": {
            "type": "boolean"
          },
          "dropped_before_seq": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "SessionChunk": {
        "type": "object",
        "required": [
          "seq",
          "stream",
          "data"
        ],
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 1
          },
          "stream": {
            "type": "string",
            "enum": [
              "stdout",
              "stderr"
            ]
          },
          "data": {
            "type": "string"
          }
        }
      },
      "SessionOutput": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SessionState"
          },
          {
            "type": "object",
            "required": [
