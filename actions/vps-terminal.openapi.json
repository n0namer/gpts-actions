              "has_more"
            ],
            "properties": {
              "chunks": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/SessionChunk"
                }
              },
              "has_more": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "SessionInput": {
        "type": "object",
        "additionalProperties": false,
        "description": "Provide exactly one of data or data_base64.",
        "properties": {
          "data": {
            "type": "string",
            "description": "UTF-8 stdin bytes."
          },
          "data_base64": {
            "type": "string",
            "description": "Base64-encoded stdin bytes."
          }
        },
        "oneOf": [
          {
            "required": [
